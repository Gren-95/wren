<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="WrenBreadcrumbBar" parent="GtkWidget">
    <child>
      <object class="GtkStack" id="mode_stack">
        <property name="hexpand">true</property>
        <property name="transition-type">crossfade</property>
        <property name="transition-duration">120</property>
        <property name="valign">center</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">crumbs</property>
            <property name="child">
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">external</property>
                <property name="vscrollbar-policy">never</property>
                <property name="hexpand">true</property>
                <property name="propagate-natural-width">true</property>
                <property name="valign">center</property>
                <style>
                  <class name="wren-crumb-scroll"/>
                </style>
                <child>
                  <object class="GtkBox" id="crumb_box">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">0</property>
                    <property name="valign">center</property>
                    <style>
                      <class name="wren-crumb-box"/>
                    </style>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">entry</property>
            <property name="child">
              <object class="GtkEntry" id="path_entry">
                <property name="hexpand">true</property>
                <property name="placeholder-text">Enter path…</property>
                <style>
                  <class name="wren-path-entry"/>
                </style>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
